# Set secrets in Render's Environment tab. Never commit a real key.
TAVILY_API_KEY=
PORT=3000
# Optional password for a private beta, sent only to your own server.
SEARCH_ACCESS_CODE=
# Per-instance circuit breakers; use provider-side limits as the billing authority.
MAX_SEARCHES_PER_DAY=100
MAX_CONCURRENT_SEARCHES=3
# Accounts (optional). Both values are public by design; the browser receives them.
# Supabase → Project Settings → API Keys. Never put the secret/service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Pro (AI). Without ANTHROPIC_API_KEY every Pro feature stays off.
ANTHROPIC_API_KEY=
# Comma-separated codes (8+ characters) that unlock Pro before billing is live.
PRO_PREVIEW_CODES=
# Hard cap on AI spend per day across all students, in US dollars.
AI_DAILY_BUDGET_USD=5
# Optional: your email, sent to OpenAlex for its faster "polite" API pool.
CONTACT_EMAIL=

# Billing with Paddle (all optional until you sell Pro).
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_SEASON=
PADDLE_WEBHOOK_SECRET=
# Server-only Supabase secret key: lets the Paddle webhook record subscriptions. Never expose it.
SUPABASE_SECRET_KEY=
